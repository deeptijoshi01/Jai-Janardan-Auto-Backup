PORT=5000
NODE_ENV=development
MONGO_URI=

# Existing configured admin account; it is hashed into MongoDB on its first successful login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# SMTP reset email settings (all are required for password recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FRONTEND_URL=http://localhost:5173

# Use "none" only when the production frontend and API are on different sites.
# Production cookies always require HTTPS.
COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
